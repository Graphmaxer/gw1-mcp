{
  "name": "gw1-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "A Guild Wars 1 build compiler for LLMs (MCP server)",
  "license": "MIT",
  "scripts": {
    "bench": "pnpm -r bench",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "oxlint --deny-warnings packages types",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r exec vitest run --coverage --coverage.reporter=text",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm -r typecheck && pnpm lint && pnpm fmt:check && pnpm -r test && pnpm knip"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "knip": "^6.33.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
