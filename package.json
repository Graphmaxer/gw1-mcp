{
  "name": "gw1-mcp",
  "version": "1.2.0",
  "private": true,
  "description": "A Guild Wars 1 build compiler for LLMs (MCP server)",
  "license": "MIT",
  "scripts": {
    "bench": "pnpm -r bench",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "oxlint --deny-warnings packages types",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r exec vitest run --coverage --coverage.reporter=text",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm -r typecheck && pnpm lint && pnpm fmt:check && pnpm -r test && pnpm knip"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "knip": "^6.45.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
