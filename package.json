{
  "name": "gw1-mcp",
  "version": "1.1.3",
  "private": true,
  "description": "A Guild Wars 1 build compiler for LLMs (MCP server)",
  "license": "MIT",
  "scripts": {
    "bench": "pnpm -r bench",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "oxlint --deny-warnings packages types",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r exec vitest run --coverage --coverage.reporter=text",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm -r typecheck && pnpm lint && pnpm fmt:check && pnpm -r test && pnpm knip"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "knip": "^6.45.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
}
