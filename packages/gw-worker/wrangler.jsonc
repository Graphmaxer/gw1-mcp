{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gw1-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // No compatibility flags. `nodejs_compat` was carried here and removed on
  // 2026-07-31 after proving it does nothing for this Worker: the bundle contains
  // no `node:` specifier, no unenv polyfill and no Node global (the only matches
  // are `$ZodPreprocess` and Web-standard `arrayBuffer`), it is byte-identical
  // with and without the flag, and under real workerd every route and every tool
  // answers correctly without it.
  //
  // Removing it is the point rather than tidiness: with the flag set, a future
  // dependency that quietly needs a Node API gets silently polyfilled by unenv
  // and fails later at the call site with "[unenv] ... is not implemented yet".
  // Without it, that dependency fails to resolve at build time, where it is
  // obvious. If one legitimately needs Node APIs, add the flag back deliberately.
  "compatibility_flags": [],
  "observability": { "enabled": true },
  // Aggregate, anonymous usage counters (tool NAME only, never arguments).
  // Requires Analytics Engine enabled on the account (dash: Storage &
  // Databases > Analytics Engine). The binding is optional in code: local
  // dev and tests run without it.
  // Per-IP rate limiting (GA "ratelimits" binding, wrangler >= 4.36): protects
  // CPU and Analytics Engine writes from abuse. Two documented choices:
  // (1) workers.dev requests still count against the daily quota even when
  // 429'd — true pre-worker blocking would need a custom domain + WAF rules;
  // (2) the key is the connecting IP, which Cloudflare's docs advise against
  // (CGNAT/proxies share IPs) — but this server is public and anonymous: no
  // API keys, no user ids, one path. IP is the only actor signal there is,
  // and 100/min is generous enough for shared-IP collateral.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 },
    },
  ],
  "analytics_engine_datasets": [{ "binding": "MCP_ANALYTICS", "dataset": "gw1_mcp_usage" }],
  "rules": [{ "type": "Data", "globs": ["**/*.png"], "fallthrough": true }],
}
